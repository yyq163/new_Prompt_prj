{"type":"frame-snapshot","snapshot":{"callId":"call@38","snapshotName":"before@call@38","pageId":"page@0d7b3aa8ba9239293c6c3880f249a6f1","frameId":"frame@88449aa0c165bbdbb29df7f66fbc8c7e","frameUrl":"http://127.0.0.1:8793/","doctype":"html","html":["HTML",{"lang":"zh-CN"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:8793/"}],"\n  ",["META",{"charset":"utf-8"}],"\n  ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1"}],"\n  ",["TITLE",{},"帧界图片生成器快速版"],"\n  ",["LINK",{"rel":"icon","href":"[REDACTED_INLINE_IMAGE_SCHEME]/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='24' fill='%230057df'/%3E%3C/svg%3E"}],"\n  ",["STYLE",{},"\n    :root {\n      color-scheme: light;\n      --page-bg: #e5eaf2;\n      --bg: #f8fafc;\n      --sidebar: #ffffff;\n      --surface: #ffffff;\n      --surface-soft: #f3f6fb;\n      --preview: #d1d1d3;\n      --ink: #1e293b;\n      --muted: #64748b;\n      --line: #e2e8f0;\n      --strong-line: #cbd5e1;\n      --blue: #0057df;\n      --yellow: #b45309;\n      --danger: #e0523f;\n      --ok: #087052;\n      --shadow: 0 16px 38px rgba(31, 31, 36, .06);\n      --panel-shadow: 0 18px 46px rgba(15, 23, 42, .08);\n      --radius: 16px;\n      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      min-height: 100%;\n    }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--page-bg);\n    }\n\n    button,\n    input,\n    textarea,\n    select {\n      font: inherit;\n    }\n\n    button,\n    a.button-link {\n      border: 0;\n      border-radius: 10px;\n      min-height: 44px;\n      padding: 0 18px;\n      cursor: pointer;\n      background: var(--surface);\n      color: var(--ink);\n      text-decoration: none;\n      display: inline-grid;\n      place-items: center;\n      transition: transform .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;\n    }\n\n    button:hover,\n    a.button-link:hover {\n      transform: translateY(-1px);\n      box-shadow: 0 10px 24px rgba(36, 36, 42, .12);\n    }\n\n    button:disabled {\n      cursor: not-allowed;\n      opacity: .48;\n      transform: none;\n      box-shadow: none;\n    }\n\n    .primary {\n      min-width: 142px;\n      background: var(--yellow);\n      color: #ffffff;\n      font-weight: 700;\n    }\n\n    .ghost {\n      border: 1px solid var(--line);\n      background: var(--surface);\n      color: #5f606d;\n    }\n\n    .icon-button {\n      width: 42px;\n      min-width: 42px;\n      padding: 0;\n      border: 1px solid var(--strong-line);\n      background: #f8f8fc;\n      color: #34343b;\n    }\n\n    .app-shell {\n      width: min(100%, 1360px);\n      min-height: 100vh;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: 250px minmax(0, 1fr);\n      grid-template-rows: 70px minmax(0, 1fr);\n      background: var(--bg);\n      border: 0;\n      box-shadow: 0 24px 70px rgba(30, 41, 59, .10);\n      overflow: hidden;\n    }\n\n    .topbar {\n      grid-column: 1 / -1;\n      display: flex;\n      align-items: center;\n      padding: 0 28px;\n      background: var(--surface);\n      border-bottom: 1px solid var(--line);\n    }\n\n    .sidebar {\n      position: relative;\n      z-index: 5;\n      background: var(--sidebar);\n      padding: 26px 18px;\n      display: grid;\n      grid-template-rows: 1fr auto;\n      align-content: start;\n      gap: 24px;\n      border-right: 1px solid var(--line);\n    }\n\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      min-width: 0;\n      padding: 0 2px;\n    }\n\n    .brand-mark {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      background: var(--blue);\n      flex: 0 0 auto;\n    }\n\n    .brand-title {\n      margin: 0;\n      min-width: 0;\n      color: #24242b;\n      font-size: 16px;\n      font-weight: 800;\n      line-height: 1.25;\n      white-space: normal;\n      overflow: visible;\n      text-overflow: clip;\n    }\n\n    .nav {\n      display: grid;\n      align-content: start;\n      gap: 26px;\n    }\n\n    .nav-button {\n      display: grid;\n      grid-template-columns: 38px 1fr;\n      align-items: center;\n      gap: 10px;\n      width: 100%;\n      min-height: 52px;\n      padding: 0 10px;\n      border-radius: 12px;\n      background: transparent;\n      color: #2f2f35;\n      text-align: left;\n      font-size: 16px;\n      font-weight: 700;\n      box-shadow: none;\n    }\n\n    .nav-button:hover {\n      background: #f7f7fa;\n      transform: none;\n      box-shadow: none;\n    }\n\n    .nav-button.active {\n      background: #f1f5ff;\n      color: var(--blue);\n    }\n\n    .nav-icon {\n      width: 22px;\n      height: 22px;\n      display: inline-grid;\n      place-items: center;\n      color: currentColor;\n    }\n\n    .nav-icon svg {\n      display: block;\n      width: 22px;\n      height: 22px;\n      fill: currentColor;\n    }\n\n    .side-status {\n      display: grid;\n      gap: 8px;\n      align-self: end;\n      padding: 14px;\n      border: 1px solid var(--line);\n      border-radius: 14px;\n      color: #626371;\n      font-size: 13px;\n      line-height: 1.45;\n    }\n\n    .mode-pill {\n      display: inline-flex;\n      width: fit-content;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 10px;\n      border-radius: 999px;\n      background: #eff4ff;\n      color: #0057df;\n      font-weight: 800;\n    }\n\n    .mode-pill::before {\n      content: \"\";\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: currentColor;\n    }\n\n    .workspace {\n      min-width: 0;\n      display: grid;\n      grid-template-columns: minmax(620px, 760px) minmax(300px, 360px);\n      justify-content: center;\n      gap: 28px;\n      padding: 32px 36px 40px;\n      overflow: auto;\n      align-items: start;\n    }\n\n    .workspace.config-open {\n      grid-template-columns: minmax(0, 1fr);\n    }\n\n    .workspace-main,\n    .history-column,\n    .config-panel {\n      min-width: 0;\n    }\n\n    .workspace-main {\n      display: grid;\n      gap: 0;\n      align-content: start;\n    }\n\n    .workspace-main > * {\n      min-width: 0;\n      max-width: 100%;\n    }\n\n    .generator-view {\n      width: 100%;\n      justify-self: end;\n      background: var(--surface);\n      border: 1px solid var(--line);\n      border-radius: 22px;\n      box-shadow: var(--panel-shadow);\n      overflow: hidden;\n    }\n\n    .section-title {\n      margin: 0 0 10px 10px;\n      color: #626371;\n      font-size: 15px;\n      font-weight: 700;\n    }\n\n    .generator-view > .section-title {\n      margin: 0;\n      padding: 18px 24px 12px;\n    }\n\n    .preview-card {\n      position: sticky;\n      top: 0;\n      z-index: 1;\n      width: 100%;\n      min-width: 0;\n      max-width: 100%;\n      background: var(--surface);\n      box-shadow: none;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .preview-stage {\n      position: relative;\n      aspect-ratio: 16 / 9;\n      overflow: hidden;\n      background:\n        linear-gradient(180deg, rgba(255, 255, 255, .14), rgba(18, 18, 26, .32)),\n        var(--preview);\n    }\n\n    .preview-stage img {\n      width: 100%;\n      height: 100%;\n      object-fit: contain;\n      display: block;\n      background:\n        linear-gradient(45deg, #eeeeef 25%, transparent 25%),\n        linear-gradient(-45deg, #eeeeef 25%, transparent 25%),\n        linear-gradient(45deg, transparent 75%, #eeeeef 75%),\n        linear-gradient(-45deg, transparent 75%, #eeeeef 75%);\n      background-position: 0 0, 0 10px, 10px -10px, -10px 0;\n      background-size: 20px 20px;\n    }\n\n    .preview-stage:fullscreen,\n    .preview-stage:-webkit-full-screen,\n    .preview-stage.is-immersive-preview {\n      position: fixed;\n      inset: 0;\n      z-index: 1000;\n      width: 100vw;\n      height: 100vh;\n      aspect-ratio: auto;\n      display: block;\n      background: #111116;\n    }\n\n    .preview-stage:fullscreen img,\n    .preview-stage:-webkit-full-screen img,\n    .preview-stage.is-immersive-preview img {\n      position: absolute;\n      left: 0;\n      top: 0;\n      width: auto;\n      height: auto;\n      max-width: none;\n      max-height: none;\n      object-fit: initial;\n      user-select: none;\n      -webkit-user-drag: none;\n      will-change: transform;\n      pointer-events: none;\n    }\n\n    .preview-stage:fullscreen,\n    .preview-stage:-webkit-full-screen,\n    .preview-stage.is-immersive-preview {\n      cursor: grab;\n      touch-action: none;\n    }\n\n    .preview-stage.is-dragging:fullscreen,\n    .preview-stage.is-dragging:-webkit-full-screen,\n    .preview-stage.is-dragging.is-immersive-preview {\n      cursor: grabbing;\n    }\n\n    .preview-stage:fullscreen .preview-toolbar,\n    .preview-stage:-webkit-full-screen .preview-toolbar,\n    .preview-stage.is-immersive-preview .preview-toolbar {\n      top: 24px;\n      right: 24px;\n      z-index: 3;\n    }\n\n    .preview-stage:fullscreen .preview-caption,\n    .preview-stage:-webkit-full-screen .preview-caption,\n    .preview-stage.is-immersive-preview .preview-caption {\n      left: 24px;\n      bottom: 24px;\n      max-width: calc(100% - 48px);\n      z-index: 3;\n    }\n\n    .preview-stage:fullscreen .preview-placeholder,\n    .preview-stage:-webkit-full-screen .preview-placeholder,\n    .preview-stage.is-immersive-preview .preview-placeholder {\n      pointer-events: none;\n    }\n\n    .preview-placeholder {\n      position: absolute;\n      inset: 0;\n      display: grid;\n      place-items: center;\n      color: #646574;\n      text-align: center;\n      padding: 28px;\n    }\n\n    .preview-placeholder strong {\n      display: block;\n      color: #555560;\n      font-size: 18px;\n      margin-bottom: 8px;\n    }\n\n    .preview-toolbar {\n      position: absolute;\n      top: 20px;\n      right: 20px;\n      display: flex;\n      gap: 10px;\n    }\n\n    .preview-caption {\n      position: absolute;\n      left: 20px;\n      bottom: 18px;\n      max-width: min(560px, calc(100% - 40px));\n      padding: 8px 12px;\n      border-radius: 999px;\n      background: rgba(255, 255, 255, .78);\n      color: #555560;\n      font-size: 13px;\n      font-weight: 700;\n      backdrop-filter: blur(16px);\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .mode-tabs {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      align-items: center;\n      min-height: 60px;\n      border-bottom: 1px solid var(--line);\n      background: var(--surface);\n    }\n\n    .tab-button {\n      height: 60px;\n      min-height: 60px;\n      border-radius: 0;\n      background: transparent;\n      color: #6e6f7d;\n      font-size: 16px;\n      font-weight: 800;\n      box-shadow: none;\n      position: relative;\n    }\n\n    .tab-button:hover {\n      transform: none;\n      box-shadow: none;\n      background: #fbfbfd;\n    }\n\n    .tab-button.active {\n      color: #393942;\n    }\n\n    .tab-button.active::after {\n      content: \"\";\n      position: absolute;\n      left: 30%;\n      right: 30%;\n      bottom: 0;\n      height: 2px;\n      background: #383842;\n    }\n\n    .prompt-card {\n      min-width: 0;\n      max-width: 100%;\n      padding: 28px 32px 32px;\n      background: var(--surface);\n    }\n\n    .prompt-box {\n      min-height: 168px;\n      width: 100%;\n      border: 1px solid var(--line);\n      border-radius: 16px;\n      background: #f8fafc;\n      resize: vertical;\n      padding: 20px;\n      color: #34343c;\n      line-height: 1.55;\n      outline: none;\n      font-size: 15px;\n    }\n\n    .prompt-box:focus,\n    input:focus,\n    select:focus,\n    textarea:focus {\n      border-color: rgba(8, 102, 255, .45);\n      box-shadow: 0 0 0 4px rgba(8, 102, 255, .08);\n    }\n\n    .control-row {\n      display: grid;\n      grid-template-columns: 152px minmax(0, 1fr) minmax(0, 1fr);\n      grid-template-areas:\n        \"generate count aspect\"\n        \"generate resolution resolution\"\n        \"quality output clear\"\n        \"feedback feedback feedback\";\n      gap: 12px;\n      align-items: stretch;\n      margin-top: 16px;\n      padding: 16px;\n      border: 1px solid var(--line);\n      border-radius: 18px;\n      background: #f8fafc;\n    }\n\n    .generate-action {\n      grid-area: generate;\n      width: 100%;\n      min-height: 100px;\n      align-self: stretch;\n      border-radius: 14px;\n      font-size: 16px;\n    }\n\n    .control-count {\n      grid-area: count;\n    }\n\n    .control-aspect {\n      grid-area: aspect;\n    }\n\n    .control-quality {\n      grid-area: quality;\n    }\n\n    .control-output {\n      grid-area: output;\n    }\n\n    .clear-action {\n      grid-area: clear;\n      width: 100%;\n      min-height: 44px;\n      background: #ffffff;\n      color: #64748b;\n      font-weight: 800;\n    }\n\n    .config-feedback {\n      min-height: 18px;\n      margin-top: -4px;\n      color: #8b8c98;\n      font-size: 12px;\n      font-weight: 800;\n      line-height: 1.35;\n    }\n\n    .config-feedback.good {\n      color: #287a44;\n    }\n\n    .config-feedback.bad {\n      color: #bd3434;\n    }\n\n    .config-feedback.busy {\n      color: #6f707b;\n    }\n\n    .generator-feedback {\n      grid-area: feedback;\n      min-height: 18px;\n      margin-top: 0;\n      color: #6f707d;\n      font-size: 12px;\n      font-weight: 800;\n      line-height: 1.35;\n    }\n\n    .generator-feedback.good {\n      color: #287a44;\n    }\n\n    .generator-feedback.bad {\n      color: #bd3434;\n    }\n\n    .generator-feedback.busy {\n      color: #555763;\n    }\n\n    .optimizer-panel {\n      margin-top: 12px;\n      border: 1px solid rgba(128, 140, 166, .22);\n      border-radius: 14px;\n      background: rgba(255, 255, 255, .72);\n      padding: 14px;\n      display: grid;\n      gap: 12px;\n    }\n\n    .optimizer-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n\n    .optimizer-title {\n      margin: 0;\n      color: var(--ink);\n      font-size: 14px;\n      font-weight: 900;\n    }\n\n    .optimizer-tools,\n    .optimizer-actions {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      flex-wrap: wrap;\n    }\n\n    .optimizer-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(180px, 1fr));\n      gap: 10px;\n    }\n\n    .optimizer-field {\n      display: grid;\n      gap: 6px;\n      color: #6f707d;\n      font-size: 12px;\n      font-weight: 800;\n    }\n\n    .optimizer-field input,\n    .optimizer-field select {\n      width: 100%;\n      min-height: 38px;\n      border: 1px solid rgba(128, 140, 166, .28);\n      border-radius: 10px;\n      background: #fff;\n      color: #30313a;\n      padding: 0 10px;\n      font: inherit;\n      font-weight: 700;\n      outline: none;\n    }\n\n    .optimizer-reference-list {\n      display: grid;\n      gap: 10px;\n    }\n\n    .optimizer-reference-row {\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr)) auto;\n      gap: 8px;\n      align-items: end;\n      padding: 10px;\n      border: 1px solid rgba(128, 140, 166, .2);\n      border-radius: 12px;\n      background: rgba(248, 250, 252, .82);\n    }\n\n    .optimizer-reference-row .wide {\n      grid-column: span 2;\n    }\n\n    .optimizer-reference-row .remove-reference {\n      width: 38px;\n      height: 38px;\n      min-width: 38px;\n      padding: 0;\n    }\n\n    .optimizer-status {\n      min-height: 18px;\n      color: #6f707d;\n      font-size: 12px;\n      font-weight: 800;\n      line-height: 1.35;\n    }\n\n    .optimizer-status.good {\n      color: #287a44;\n    }\n\n    .optimizer-status.bad {\n      color: #bd3434;\n    }\n\n    .optimizer-status.busy {\n      color: #555763;\n    }\n\n    .optimizer-trace {\n      color: #6f707d;\n      font-size: 12px;\n      font-weight: 800;\n      word-break: break-all;\n    }\n\n    .optimizer-warnings {\n      margin: 0;\n      padding-left: 18px;\n      color: #6f707d;\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    .app-toast {\n      position: fixed;\n      right: 28px;\n      bottom: 28px;\n      z-index: 60;\n      max-width: 360px;\n      padding: 12px 14px;\n      border: 1px solid rgba(34, 34, 42, .08);\n      border-radius: 12px;\n      background: rgba(255, 255, 255, .96);\n      color: #43444f;\n      box-shadow: 0 18px 40px rgba(30, 30, 38, .16);\n      font-size: 13px;\n      font-weight: 800;\n      line-height: 1.4;\n      pointer-events: none;\n    }\n\n    .app-toast.good {\n      color: #287a44;\n      border-color: rgba(40, 122, 68, .16);\n    }\n\n    .app-toast.bad {\n      color: #bd3434;\n      border-color: rgba(189, 52, 52, .18);\n    }\n\n    .app-toast.busy {\n      color: #555763;\n    }\n\n    .select-chip {\n      display: inline-flex;\n      align-items: center;\n      justify-content: space-between;\n      width: 100%;\n      min-height: 44px;\n      border: 1px solid var(--line);\n      border-radius: 10px;\n      background: #ffffff;\n      overflow: hidden;\n    }\n\n    .select-chip span {\n      flex: 0 0 auto;\n      min-width: 58px;\n      padding: 0 10px 0 12px;\n      color: #64748b;\n      font-size: 14px;\n      font-weight: 800;\n    }\n\n    .select-chip select,\n    .select-chip input {\n      width: 100%;\n      min-width: 0;\n      min-height: 44px;\n      border: 0;\n      border-left: 1px solid var(--line);\n      border-radius: 0;\n      background: transparent;\n      color: #3d3d47;\n      font-weight: 800;\n      padding: 0 12px;\n      outline: none;\n    }\n\n    .compact-input {\n      width: 92px;\n    }\n\n    .resolution-block {\n      grid-area: resolution;\n      display: grid;\n      gap: 6px;\n      align-self: start;\n      min-width: 0;\n    }\n\n    .resolution-note {\n      color: #6f707d;\n      font-size: 12px;\n      line-height: 1.2;\n      font-weight: 700;\n      white-space: normal;\n      padding-left: 2px;\n    }\n\n    .size-inline {\n      color: #6f707b;\n      font-weight: 800;\n    }\n\n    .prompt-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      margin: 0 10px 10px;\n    }\n\n    .prompt-head .section-title {\n      margin: 0;\n    }\n\n    .reference-film {\n      min-width: 0;\n      display: none;\n      align-items: center;\n      width: 112px;\n      max-width: 620px;\n      min-height: 62px;\n      padding: 8px 14px;\n      border-radius: 14px;\n      background: rgba(255, 255, 255, .78);\n      overflow: visible;\n      scrollbar-width: none;\n      transition: width .2s ease, background .2s ease, box-shadow .2s ease;\n    }\n\n    .prompt-card.image-mode .reference-film,\n    .reference-film.has-items {\n      display: flex;\n    }\n\n    .reference-film:hover,\n    .reference-film:focus-within {\n      width: min(620px, 100%);\n      background: rgba(255, 255, 255, .92);\n      box-shadow: 0 10px 28px rgba(34, 34, 42, .08);\n    }\n\n    .prompt-card.image-mode .reference-film {\n      width: min(620px, 100%);\n      background: rgba(255, 255, 255, .92);\n      overflow-x: auto;\n      overflow-y: visible;\n    }\n\n    .reference-film::-webkit-scrollbar {\n      display: none;\n    }\n\n    .asset-tile {\n      position: relative;\n      width: 46px;\n      height: 46px;\n      flex: 0 0 46px;\n      margin-left: -28px;\n      transform: rotate(-7deg);\n      transform-origin: center;\n      overflow: visible;\n      z-index: 1;\n      transition: margin-left .2s ease, transform .18s ease, z-index .18s ease;\n    }\n\n    .asset-tile:first-child {\n      margin-left: 0;\n    }\n\n    .asset-tile:nth-child(even) {\n      transform: rotate(5deg) translateY(-1px);\n    }\n\n    .reference-film:hover .asset-tile,\n    .reference-film:focus-within .asset-tile {\n      margin-left: 4px;\n    }\n\n    .prompt-card.image-mode .asset-tile {\n      margin-left: 4px;\n      transform: none;\n    }\n\n    .reference-film:hover .asset-tile:first-child,\n    .reference-film:focus-within .asset-tile:first-child,\n    .prompt-card.image-mode .asset-tile:first-child {\n      margin-left: 0;\n    }\n\n    .asset-tile:hover,\n    .asset-tile.selected {\n      transform: rotate(0deg) translateY(-7px) scale(1.08);\n      z-index: 8;\n    }\n\n    .asset-preview,\n    .asset-upload,\n    .asset-loading {\n      width: 46px;\n      height: 46px;\n      min-height: 46px;\n      border: 0;\n      border-radius: 4px;\n      background: #f1f2f5;\n      color: #a2a4af;\n      padding: 0;\n      overflow: hidden;\n      box-shadow: 0 7px 15px rgba(40, 40, 48, .12);\n    }\n\n    .asset-preview:hover,\n    .asset-upload:hover {\n      transform: none;\n      box-shadow: 0 9px 18px rgba(40, 40, 48, .15);\n    }\n\n    .asset-preview img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .asset-upload {\n      position: relative;\n      display: grid;\n      place-items: center;\n      text-align: center;\n      font-size: 9px;\n      line-height: 1.25;\n      font-weight: 800;\n      cursor: pointer;\n    }\n\n    .asset-upload .plus {\n      display: block;\n      color: #9ba0ac;\n      font-size: 21px;\n      line-height: .85;\n      font-weight: 400;\n    }\n\n    .asset-upload input {\n      position: absolute;\n      inset: 0;\n      opacity: 0;\n      cursor: pointer;\n    }\n\n    .file-input-proxy {\n      position: fixed;\n      left: -9999px;\n      top: 0;\n      width: 1px;\n      height: 1px;\n      opacity: 0;\n    }\n\n    .asset-loading {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      align-items: stretch;\n      justify-content: center;\n      gap: 3px;\n      padding: 6px 5px 10px;\n      color: #7b8190;\n      font-size: 9px;\n      line-height: 1.15;\n      font-weight: 800;\n      text-align: center;\n      background: linear-gradient(180deg, #f7f8fb, #eef2f7);\n    }\n\n    .asset-loading::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(110deg, transparent 20%, rgba(0, 87, 223, .14) 42%, transparent 64%);\n      transform: translateX(-100%);\n      animation: asset-upload-sweep 1.1s linear infinite;\n    }\n\n    .asset-loading-label,\n    .asset-loading-percent {\n      position: relative;\n      z-index: 1;\n      display: block;\n      min-width: 0;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .asset-loading-percent {\n      color: #0057df;\n      font-size: 8px;\n      line-height: 1;\n    }\n\n    .asset-progress {\n      position: absolute;\n      left: 6px;\n      right: 6px;\n      bottom: 5px;\n      height: 4px;\n      border-radius: 999px;\n      overflow: hidden;\n      background: rgba(0, 87, 223, .13);\n    }\n\n    .asset-progress > b {\n      content: \"\";\n      display: block;\n      width: 0;\n      height: 100%;\n      border-radius: inherit;\n      background: #0057df;\n      transition: width .18s ease;\n    }\n\n    .asset-progress.is-indeterminate > b {\n      width: 46%;\n      animation: asset-upload-progress 1s ease-in-out infinite;\n    }\n\n    @keyframes asset-upload-sweep {\n      to {\n        transform: translateX(100%);\n      }\n    }\n\n    @keyframes asset-upload-progress {\n      0% {\n        transform: translateX(-120%);\n      }\n      100% {\n        transform: translateX(240%);\n      }\n    }\n\n    .asset-tooltip {\n      position: absolute;\n      left: 50%;\n      bottom: calc(100% + 9px);\n      transform: translateX(-50%) translateY(4px);\n      min-width: 62px;\n      padding: 8px 10px;\n      border-radius: 6px;\n      background: #20242b;\n      color: #ffffff;\n      font-size: 12px;\n      font-weight: 800;\n      text-align: center;\n      opacity: 0;\n      pointer-events: none;\n      transition: opacity .16s ease, transform .16s ease;\n      white-space: nowrap;\n      box-shadow: 0 8px 18px rgba(21, 24, 30, .22);\n    }\n\n    .asset-tooltip::after {\n      content: \"\";\n      position: absolute;\n      left: 50%;\n      top: 100%;\n      width: 8px;\n      height: 8px;\n      background: #20242b;\n      transform: translate(-50%, -5px) rotate(45deg);\n    }\n\n    .asset-remove {\n      position: absolute;\n      top: -7px;\n      right: -7px;\n      width: 18px;\n      min-width: 18px;\n      height: 18px;\n      min-height: 18px;\n      padding: 0;\n      border-radius: 50%;\n      background: #2a2d34;\n      color: #ffffff;\n      font-size: 14px;\n      line-height: 18px;\n      opacity: 0;\n      box-shadow: 0 4px 10px rgba(25, 25, 30, .2);\n    }\n\n    .asset-add-badge {\n      position: absolute;\n      right: -7px;\n      bottom: -7px;\n      width: 22px;\n      height: 22px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: #f6f7fa;\n      color: #5f6470;\n      font-size: 19px;\n      box-shadow: 0 5px 14px rgba(36, 36, 42, .12);\n      pointer-events: none;\n    }\n\n    .asset-tile.has-image:hover .asset-tooltip {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0);\n    }\n\n    .asset-tile.has-image:hover .asset-remove {\n      opacity: 1;\n    }\n\n    .history-actions {\n      grid-column: 1 / -1;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      border-top: 1px solid var(--line);\n    }\n\n    .history-actions a,\n    .history-actions button,\n    .history-actions span {\n      min-height: 30px;\n      border-radius: 0;\n      background: transparent;\n      color: #727380;\n      font-size: 12px;\n      font-weight: 700;\n      text-decoration: none;\n      display: grid;\n      place-items: center;\n      padding: 0;\n      box-shadow: none;\n    }\n\n    .history-thumb.status-thumb {\n      display: grid;\n      place-items: center;\n      color: #686977;\n      font-size: 12px;\n      font-weight: 800;\n      line-height: 1.2;\n      text-align: center;\n      padding: 6px;\n    }\n\n    .history-card.failed .history-thumb.status-thumb {\n      color: #bd3434;\n      border-color: rgba(189, 52, 52, .24);\n      background: #fff4f2;\n    }\n\n    .history-card.succeeded .avatar {\n      background: #087052;\n    }\n\n    .history-card.failed .avatar {\n      background: #bd3434;\n    }\n\n    .history-actions a + button {\n      border-left: 1px solid var(--line);\n    }\n\n    .history-variants {\n      grid-column: 1 / -1;\n      display: flex;\n      gap: 6px;\n      min-width: 0;\n      overflow-x: auto;\n      padding: 2px 0 0;\n    }\n\n    .history-variant {\n      width: 38px;\n      height: 38px;\n      min-width: 38px;\n      border: 1px solid var(--strong-line);\n      border-radius: 8px;\n      overflow: hidden;\n      padding: 0;\n      background: #f6f7fa;\n      box-shadow: none;\n    }\n\n    .history-variant img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .history-count {\n      color: #0866ff;\n    }\n\n    .history-column {\n      position: sticky;\n      top: 32px;\n      z-index: 2;\n      display: grid;\n      align-content: start;\n      gap: 14px;\n      width: 100%;\n      padding: 18px;\n      border: 1px solid var(--line);\n      border-radius: 22px;\n      background: rgba(255, 255, 255, .76);\n      box-shadow: 0 14px 34px rgba(15, 23, 42, .05);\n      backdrop-filter: blur(10px);\n    }\n\n    .history-column .section-title {\n      margin: 0 0 2px;\n    }\n\n    .history-list {\n      display: grid;\n      gap: 12px;\n    }\n\n    .history-empty {\n      min-height: 108px;\n      border: 1px dashed var(--strong-line);\n      border-radius: 18px;\n      display: grid;\n      place-items: center;\n      color: #696a76;\n      background: rgba(255, 255, 255, .9);\n      text-align: center;\n      padding: 20px;\n    }\n\n    .history-card {\n      display: grid;\n      grid-template-columns: 54px minmax(0, 1fr) auto;\n      gap: 14px;\n      align-items: center;\n      min-height: 90px;\n      padding: 14px 16px;\n      border: 1px solid transparent;\n      border-radius: 18px;\n      background: var(--surface);\n      color: #353541;\n      box-shadow: 0 8px 22px rgba(15, 23, 42, .05);\n    }\n\n    .history-card.selected {\n      border-color: rgba(8, 102, 255, .38);\n      box-shadow: 0 0 0 3px rgba(8, 102, 255, .08);\n    }\n\n    .history-thumb {\n      width: 54px;\n      height: 54px;\n      border: 1px solid var(--strong-line);\n      border-radius: 10px;\n      overflow: hidden;\n      background:\n        linear-gradient(45deg, #eee 25%, transparent 25%),\n        linear-gradient(-45deg, #eee 25%, transparent 25%),\n        linear-gradient(45deg, transparent 75%, #eee 75%),\n        linear-gradient(-45deg, transparent 75%, #eee 75%);\n      background-position: 0 0, 0 8px, 8px -8px, -8px 0;\n      background-size: 16px 16px;\n    }\n\n    .history-thumb img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .history-title {\n      min-width: 0;\n      font-size: 15px;\n      font-weight: 800;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .history-meta {\n      display: flex;\n      gap: 6px;\n      align-items: center;\n      margin-top: 8px;\n      color: #8e8f9c;\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    .avatar {\n      width: 32px;\n      height: 32px;\n      border-radius: 50%;\n      display: grid;\n      place-items: center;\n      background: #999aa7;\n      color: white;\n      font-size: 12px;\n      font-weight: 800;\n    }\n\n    .more {\n      width: 34px;\n      min-width: 34px;\n      height: 34px;\n      padding: 0;\n      border: 0;\n      border-radius: 50%;\n      background: transparent;\n      color: #a8a9b6;\n      font-size: 24px;\n      letter-spacing: 2px;\n      display: grid;\n      place-items: center;\n      box-shadow: none;\n    }\n\n    .more:hover,\n    .more:focus-visible {\n      background: #f4f5f8;\n      color: #555765;\n    }\n\n    .config-panel {\n      display: none;\n      max-width: 760px;\n      margin: 0 auto;\n      width: 100%;\n      align-content: start;\n      gap: 18px;\n    }\n\n    .config-panel.active {\n      display: grid;\n    }\n\n    .generator-view.hidden,\n    .history-column.hidden {\n      display: none;\n    }\n\n    .config-card {\n      background: var(--surface);\n      border-radius: 20px;\n      padding: 24px;\n      box-shadow: var(--shadow);\n    }\n\n    .config-title {\n      margin: 0 0 20px;\n      font-size: 22px;\n      line-height: 1.2;\n    }\n\n    .form-grid {\n      display: grid;\n      gap: 14px;\n    }\n\n    .two {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 14px;\n    }\n\n    label {\n      display: grid;\n      gap: 8px;\n      color: #777887;\n      font-size: 13px;\n      font-weight: 800;\n    }\n\n    input,\n    textarea,\n    select {\n      width: 100%;\n      min-height: 44px;\n      border: 1px solid var(--line);\n      border-radius: 10px;\n      background: #fbfbfc;\n      color: #33333c;\n      outline: none;\n      padding: 10px 12px;\n    }\n\n    textarea {\n      min-height: 160px;\n      resize: vertical;\n      line-height: 1.5;\n    }\n\n    .payload {\n      min-height: 220px;\n      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n      font-size: 12px;\n      white-space: pre;\n      overflow: auto;\n    }\n\n    .meter {\n      display: grid;\n      gap: 6px;\n      color: #8b8c98;\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    .bar {\n      height: 8px;\n      border-radius: 999px;\n      overflow: hidden;\n      background: #ededf2;\n    }\n\n    .bar span {\n      display: block;\n      height: 100%;\n      width: 0;\n      max-width: 100%;\n      background: var(--blue);\n      transition: width .25s ease;\n    }\n\n    .check-inline.good {\n      color: var(--ok);\n      font-weight: 800;\n    }\n\n    .check-inline.bad {\n      color: #a83022;\n      font-weight: 800;\n    }\n\n    .check-inline.busy {\n      color: #1736a8;\n      font-weight: 800;\n    }\n\n    .small-note {\n      color: #8d8e99;\n      font-size: 12px;\n      line-height: 1.45;\n    }\n\n    [hidden] {\n      display: none !important;\n    }\n\n    @media (max-width: 1280px) {\n      .app-shell {\n        width: 100%;\n        margin: 0;\n      }\n\n      .workspace {\n        grid-template-columns: minmax(0, 1fr);\n      }\n\n      .generator-view {\n        width: 100%;\n      }\n\n      .history-column {\n        grid-row: 2;\n        position: relative;\n        top: auto;\n      }\n\n      .reference-film {\n        max-width: 520px;\n      }\n    }\n\n    @media (max-width: 980px) {\n      .control-row {\n        grid-template-columns: 1fr 1fr;\n        grid-template-areas:\n          \"generate generate\"\n          \"count aspect\"\n          \"resolution resolution\"\n          \"quality output\"\n          \"clear clear\"\n          \"feedback feedback\";\n      }\n\n      .generate-action {\n        min-height: 52px;\n      }\n    }\n\n    @media (max-width: 760px) {\n      html,\n      body {\n        overflow-x: hidden;\n      }\n\n      .app-shell {\n        width: 100%;\n        min-height: 100vh;\n        margin: 0;\n        grid-template-columns: 1fr;\n        grid-template-rows: 64px auto minmax(0, 1fr);\n        border: 0;\n      }\n\n      .topbar {\n        padding: 0 16px;\n      }\n\n      .sidebar {\n        grid-template-rows: auto;\n        gap: 12px;\n        padding: 16px;\n        border-right: 0;\n        border-bottom: 1px solid var(--line);\n      }\n\n      .nav {\n        display: grid;\n        grid-template-columns: 1fr;\n        width: 100%;\n      }\n\n      .side-status {\n        display: none;\n      }\n\n      .workspace {\n        width: 100%;\n        max-width: 100vw;\n        grid-template-columns: minmax(0, 1fr);\n        padding: 16px 12px 28px;\n        overflow-x: hidden;\n      }\n\n      .control-row {\n        grid-template-columns: 1fr;\n        grid-template-areas:\n          \"generate\"\n          \"count\"\n          \"aspect\"\n          \"resolution\"\n          \"quality\"\n          \"output\"\n          \"clear\"\n          \"feedback\";\n      }\n\n      .generator-view,\n      .preview-card,\n      .prompt-card,\n      .history-column,\n      .config-panel,\n      .config-card {\n        width: 100%;\n        max-width: 100%;\n      }\n\n      .generator-view,\n      .history-column {\n        border-radius: 18px;\n      }\n\n      .preview-card {\n        position: relative;\n      }\n\n      .preview-stage {\n        min-height: 220px;\n        aspect-ratio: auto;\n      }\n\n      .preview-toolbar {\n        top: 14px;\n        right: 14px;\n      }\n\n      .prompt-card {\n        padding: 16px 12px 18px;\n      }\n\n      .prompt-box {\n        min-height: 120px;\n      }\n\n      .control-row {\n        display: grid;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        align-items: start;\n      }\n\n      .control-row > .primary,\n      .control-row > .ghost,\n      .control-row > .select-chip,\n      .control-row > .resolution-block {\n        width: 100%;\n        min-width: 0;\n      }\n\n      .select-chip {\n        min-width: 0;\n      }\n\n      .select-chip select,\n      .select-chip input {\n        min-width: 0;